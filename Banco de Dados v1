-- SELECT  

-- Consultar todos os clientes  

-- ===================================================== 

SELECT *FROM CLIENTE;  

-- =====================================================  

-- SELECT 

 -- Consultar uma encomenda específica 

 -- ===================================================== 

SELECT *FROM ENCOMENDA   

WHERE ID_Encomenda = 1; 

-- ===================================================== 

 -- SELECT COM JOIN  

-- Histórico de rastreamento 

 -- ===================================================== 

SELECT  

    E.ID_Encomenda,    E.Destinatario,    R.Data_Hora,    R.Localizacao,    R.Status,    R.Observacao 

FROM ENCOMENDA E 

INNER JOIN RASTREAMENTO R 

    ON E.ID_Encomenda = R.ID_Encomenda 

WHERE E.ID_Encomenda = 1 

ORDER BY R.Data_Hora; 

-- =====================================================  

-- UPDATE  

-- Atualizar status da encomenda  

-- ===================================================== 

UPDATE ENCOMENDA  

SET Status = 'Em trânsito' 

WHERE ID_Encomenda = 1; 





