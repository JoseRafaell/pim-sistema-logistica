CREATE DATABASE BD_PIM; 

GO 

USE BD_PIM 

GO; 

-- =====================================================  

-- TABELA CLIENTE  

-- ===================================================== 



CREATE TABLE CLIENTE 

( 

    ID_Cliente INT PRIMARY KEY, 

    Nome VARCHAR (100) NOT NULL, 

    CPF VARCHAR (14) NOT NULL, 

    Telefone VARCHAR (20) NOT NULL, 

    Email VARCHAR (100) NOT NULL 

); 

 -- =====================================================  

-- TABELA TRANSPORTADORA 

 -- ===================================================== 

CREATE TABLE TRANSPORTADORA 

( 

    ID_Transportadora INT PRIMARY KEY, 

    Nome VARCHAR (100) NOT NULL, 

    CNPJ VARCHAR (18) NOT NULL, 

    Telefone VARCHAR (20) NOT NULL 

); 

 -- =====================================================  

-- TABELA MOTORISTA 

 -- ===================================================== 

CREATE TABLE MOTORISTA 

( 

    ID_Motorista INT PRIMARY KEY NOT NULL, 

    ID_Transportadora INT NOT NULL, 

    Nome VARCHAR (100) NOT NULL, 

    CPF VARCHAR (14) NOT NULL, 

    CNH VARCHAR (20) NOT NULL, 

    FOREIGN KEY (ID_Transportadora) REFERENCES TRANSPORTADORA (ID_Transportadora) 

); 

 -- ===================================================== 

 -- TABELA VEICULO  

-- ===================================================== 

CREATE TABLE VEICULO 

( 

    ID_Veiculo INT PRIMARY KEY NOT NULL, 

    ID_Transportadora INT NOT NULL, 

    Placa VARCHAR (10) NOT NULL, 

    Modelo VARCHAR (50) NOT NULL, 

    Capacidade DECIMAL (10,2) NOT NULL, 

    FOREIGN KEY (ID_Transportadora) REFERENCES TRANSPORTADORA (ID_Transportadora) 

); 

 -- ===================================================== 

 -- TABELA ENCOMENDA  

-- ===================================================== 

CREATE TABLE ENCOMENDA 

( 

    ID_Encomenda INT PRIMARY KEY NOT NULL, 

    ID_Cliente INT NOT NULL, 

    Destinatario VARCHAR (100) NOT NULL, 

    Endereco VARCHAR (255) NOT NULL, 

    Peso DECIMAL (10,2) NOT NULL, 

    Valor_Frete DECIMAL (10,2) NOT NULL, 

    Status VARCHAR (50) NOT NULL, 

    FOREIGN KEY (ID_Cliente) REFERENCES CLIENTE (ID_Cliente) 

); 

 -- ===================================================== 

 -- TABELA RASTREAMENTO  

-- ===================================================== 

CREATE TABLE RASTREAMENTO 

( 

    ID_Rastreamento INT PRIMARY KEY NOT NULL, 

    ID_Encomenda INT NOT NULL, 

    Data_Hora DATETIME NOT NULL, 

    Localizacao VARCHAR (255) NOT NULL, 

    Status VARCHAR (50) NOT NULL, 

    Observacao VARCHAR (255) NOT NULL, 

    FOREIGN KEY (ID_Encomenda) REFERENCES ENCOMENDA (ID_Encomenda) 

); 

 -- =====================================================  

-- TABELA ENTREGA  

-- ===================================================== 

CREATE TABLE ENTREGA 

( 

    ID_Entrega INT PRIMARY KEY NOT NULL, 

    ID_Encomenda INT NOT NULL, 

   ID_Motorista INT NOT NULL, 

   ID_Veiculo INT NOT NULL, 

    Data_Saida DATETIME NOT NULL, 

    Data_Prevista DATETIME NOT NULL, 

    Data_Entrega DATETIME , 

    Status_Entrega VARCHAR (50) NOT NULL, 

    Observacao VARCHAR (255) NOT NULL, 

    FOREIGN KEY (ID_Encomenda) REFERENCES ENCOMENDA (ID_Encomenda), 

    FOREIGN KEY (ID_Motorista) REFERENCES MOTORISTA (ID_Motorista), 

    FOREIGN KEY (ID_Veiculo) REFERENCES VEICULO (ID_Veiculo) 

); 

